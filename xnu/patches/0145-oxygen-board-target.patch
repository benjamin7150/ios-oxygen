--- /dev/null
+++ b/pexpert/pexpert/arm64/OXYGEN.h
@@ -0,0 +1,38 @@
+#ifndef _PEXPERT_ARM64_OXYGEN_H
+#define _PEXPERT_ARM64_OXYGEN_H
+
+#define NO_MONITOR                    1
+#define NO_ECORE                      1
+
+/*
+ * Xiaomi Mi Max 2 ("oxygen", MSM8953). It shares the QGIC2, SDCC1, GCC,
+ * APPS watchdog, 8x Cortex-A53 topology and 4 KiB pages with santoni, so the
+ * inner SANTONI define keeps that bring-up. OXYGEN only selects the
+ * 1080x1920 32bpp panel geometry in the early console and bootstrap map.
+ */
+#define OXYGEN                        1
+#define SANTONI                       1
+#define SWEET                         1
+#define SWEET_SMP_MAX_CPUS            8
+
+#define ARM_ARCH_TIMER
+#define __ARM_ARCH__                  8
+#define __ARM_VMSA__                  8
+#define __ARM_VFP__                   4
+#define __ARM_COHERENT_CACHE__        1
+#define __ARM_DEBUG__                 7
+#define __ARM_ENABLE_SWAP__           1
+#define __ARM_V8_CRYPTO_EXTENSIONS__  1
+/* oxygen: Cortex-A53 is ARMv8.0 (no PAN). MSR PAN is undefined. */
+#define __ARM_PAN_AVAILABLE__         0
+
+/* Qualcomm MSM8953 has a GICv2 distributor and CPU interface, not GICv3. */
+#define HAS_GIC_V3                    0
+#define SWEET_VTIMER_INTID            20
+#define SWEET_IPI_SGI                 1
+
+#ifndef ASSEMBLER
+#define PLATFORM_PANIC_LOG_DISABLED
+#endif
+
+#endif /* _PEXPERT_ARM64_OXYGEN_H */
