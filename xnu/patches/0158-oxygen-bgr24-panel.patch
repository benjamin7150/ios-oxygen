 /*
+ * oxygen: the panel keeps scanning the ABL BGR24 buffer, so present a 32bpp
+ * BGRA frame by converting it in place (one 32-bit store per pixel; the extra
+ * byte is the next pixel's blue and is overwritten immediately).
+ */
+void
+AppleCLCD::showFrame(const uint8_t *va, uint64_t pa, uint32_t stride)
+{
+	if (!fPanelBGR24) {
+		scanFrom(pa, stride);
+		return;
+	}
+	if (fPanel == 0 || va == NULL) {
+		return;
+	}
+	for (uint32_t y = 0; y < fHeight; y++) {
+		const uint32_t *in = (const uint32_t *)(va + (uint64_t)y * stride);
+		uint8_t *out = (uint8_t *)(fPanel + (uint64_t)y * fPanelStride);
+		uint32_t x = 0;
+		for (; x + 1 < fWidth; x++) {
+			*(uint32_t *)(out + 3 * x) = in[x] & 0x00ffffffu;
+		}
+		uint32_t p = in[x];
+		out[3 * x + 0] = (uint8_t)p;
+		out[3 * x + 1] = (uint8_t)(p >> 8);
+		out[3 * x + 2] = (uint8_t)(p >> 16);
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
